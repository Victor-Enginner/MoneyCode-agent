## 2.3 DAG

```rust
// crates/core/src/dag.rs
use std::sync::Arc;

pub struct Spin { pub spin_id: String, pub number: u8, pub ts: i64 }

#[async_trait::async_trait]
pub trait Matcher: Send + Sync {
    fn id(&self) -> &'static str;
    /// `window` = últimos N números, mais recente em [0]
    fn score(&self, window: &[u8]) -> Option<f32>;
}

pub enum Regime { Permanence, Momentum, Neutral }

/// Permanência e cluster se contradizem. Sem isto você tem dois sinais
/// opostos e nenhum desempate.
pub fn classify(window: &[u8]) -> Regime {
    if window.len() < 20 { return Regime::Neutral; }
    let runs = 1 + window.windows(2).filter(|w| w[0] != w[1]).count();
    let n = window.len() as f32;
    // esperado de runs numa sequência aleatória ~ n/2; muito menos = colado
    let ratio = runs as f32 / (n / 2.0);
    if ratio < 0.75 { Regime::Permanence } else if ratio > 1.25 { Regime::Momentum } else { Regime::Neutral }
}

pub struct Aggregate { pub strategy_id: &'static str, pub confidence: f32 }

pub fn fan_in(window: &[u8], matchers: &[Arc<dyn Matcher>]) -> Vec<Aggregate> {
    let regime = classify(window);
    matchers.iter()
        .filter_map(|m| {
            let s = m.score(window)?;
            let bias = match (regime, m.id()) {
                (Regime::Permanence, id) if id.contains("cluster") => 0.85,
                (Regime::Momentum, id) if id.contains("permanencia") => 0.85,
                _ => 1.0,
            };
            Some(Aggregate { strategy_id: m.id(), confidence: s * bias })
        })
        .collect()
}
```

Matcher de permanência, com o gatilho exato que você descreveu (4–6 na mesma coluna):

```rust
// crates/strategy-native/src/permanencia.rs
pub struct QuebraColuna { pub min: usize, pub max: usize }

impl Matcher for QuebraColuna {
    fn id(&self) -> &'static str { "quebra_permanencia_coluna" }
    fn score(&self, w: &[u8]) -> Option<f32> {
        let cols: Vec<u8> = w.iter().map(|&n| if n == 0 { 0 } else { (n - 1) / 12 + 1 }).collect();
        let alvo = *cols.first()?;
        if alvo == 0 { return None; }
        let streak = cols.iter().take_while(|&&c| c == alvo).count();
        if !(self.min..=self.max).contains(&streak) { return None; }
        // confiança cresce até 5, satura em 6
        Some((0.55 + 0.08 * (streak as f32 - self.min as f32)).min(0.95))
    }
}
