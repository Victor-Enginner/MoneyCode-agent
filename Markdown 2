    fn ladder_is_triple_not_double() {
        let b = 10;
        assert_eq!(stake_cents(1, b), 10);
        assert_eq!(stake_cents(2, b), 30);
        assert_eq!(stake_cents(3, b), 90);
        assert_eq!(stake_cents(4, b), 270);
        assert_eq!(stake_cents(5, b), 810);
        assert_eq!(cum_loss_cents(5, b), 2420);
