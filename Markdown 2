## 2.2 Motor de risco (a peça que mais importa)

```rust
// crates/risk/src/lib.rs
pub const P_LOSE: f64 = 13.0 / 37.0; // 0 + coluna perdedora

/// Ficha por cobertura no degrau `step`. Cresce ×3, não ×2:
/// cobrir 2 colunas custa 2x por perda, então x = perda_acumulada + lucro_alvo.
pub fn stake_cents(step: u8, base_cents: u64) -> u64 {
    let mut d = 0u64;
    for _ in 1..step {
        let x = d + base_cents;
        d += 2 * x;
    }
    d + base_cents
}

pub fn cum_loss_cents(step: u8, base_cents: u64) -> u64 {
    (1..=step).fold(0u64, |d, _| d + 2 * (d + base_cents))
}

#[derive(Debug, Clone, Copy, PartialEq)]
pub enum Verdict { Place, Skip(Skip), Abort(Abort) }

#[derive(Debug, Clone, Copy, PartialEq)]
pub enum Skip { WindowTooShort, Cooldown }

#[derive(Debug, Clone, Copy, PartialEq)]
pub enum Abort { LadderBlown, TableLimit, Exposure, StopLoss, AlreadyEntered }

pub struct Cfg {
    pub base_cents: u64,
    pub max_steps: u8,
    pub max_bet_per_cover_cents: u64,
    pub max_exposure_pct: f64,
    pub stop_loss_cents: i64,
    pub min_window_ms: u32,
    pub cooldown_spins: u32,
}

pub struct State {
    pub bankroll_cents: i64,
    pub exposure_cents: u64,
    pub session_pnl_cents: i64,
    pub remaining_window_ms: u32,
    pub spins_since_blow: u32,
    pub step: u8,
}

pub fn authorize(cfg: &Cfg, st: &State) -> Verdict {
    if st.session_pnl_cents <= -cfg.stop_loss_cents { return Verdict::Abort(Abort::StopLoss); }
    let next = st.step + 1;
    if next > cfg.max_steps { return Verdict::Abort(Abort::LadderBlown); }
    let stake = stake_cents(next, cfg.base_cents);
    if stake > cfg.max_bet_per_cover_cents { return Verdict::Abort(Abort::TableLimit); }
    if (st.exposure_cents + 2 * stake) as f64 > st.bankroll_cents as f64 * cfg.max_exposure_pct {
        return Verdict::Abort(Abort::Exposure);
    }
    if st.spins_since_blow < cfg.cooldown_spins { return Verdict::Skip(Skip::Cooldown); }
    if st.remaining_window_ms < cfg.min_window_ms { return Verdict::Skip(Skip::WindowTooShort); }
    Verdict::Place
}

