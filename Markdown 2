## 2.4 Executor com preview e reconciliação

```rust
// crates/core/src/executor.rs
pub struct Plan { pub covers: Vec<(Cover, u64)>, pub total_cents: u64 }

/// Decompõe o valor em fichas: 8.10 → 5.00 + 2.00 + 1.00 + 0.10 (4 cliques, não 81).
pub fn decompose(total_cents: u64, denoms: &[u64]) -> Vec<(u64, u8)> {
    let mut rest = total_cents;
    let mut out = Vec::new();
    for &d in denoms { // ordem decrescente
        let n = (rest / d) as u8;
        if n > 0 { out.push((d, n)); rest -= d * n as u64; }
    }
    out
}

pub async fn place(cdp: &Cdp, plan: &Plan, cal: &Calibration) -> Result<Fills, ExecError> {
    for (cover, cents) in &plan.covers {
        let (x, y) = cal.coords(cover)?;
        cdp.click(x, y).await?;                       // seleciona a casa
        for (denom, n) in decompose(*cents, &cal.denoms) {
            cdp.click_chip(denom).await?;
            for _ in 0..n { cdp.click(x, y).await?; }
        }
    }
    let preview = cdp.read_bet_total().await?;         // lê o total no slip
    if (preview as i64 - plan.total_cents as i64).abs() > 1 {
        cdp.clear_bets().await?;
        return Err(ExecError::PreviewMismatch { preview, expected: plan.total_cents });
    }
    cdp.confirm().await?;
    cdp.collect_acks(plan).await                        // Fill parcial = naked, registra
}
```

